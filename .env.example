# Copy this file to .env and fill in your own values.
#
# The server reads this file at startup and merges it into the environment
# without overriding anything already set, so the "env" block of your MCP
# client's server configuration still wins. A .env is the way to keep the
# API key out of that configuration file, and it is also what you want when
# running the server manually (see README.md, "Run locally").
#
# Set REDMINE_ENV_FILE to keep this file outside the repository.

# Base URL of your Redmine instance (no trailing slash).
REDMINE_URL=https://redmine.example.com

# My account > API access key.
REDMINE_API_KEY=your_api_key_here

# Optional: per-request timeout, in seconds. Defaults to 15.
# REDMINE_TIMEOUT=15

# Optional: verify the Redmine server's TLS certificate. Defaults to true.
# Set to false only for a trusted self-signed/internal cert you cannot
# otherwise validate — disabling it removes protection against
# man-in-the-middle attacks on that connection.
# REDMINE_SSL_VERIFY=false

# Optional: directories the file-upload tools (attach_file_to_issue,
# attach_file_to_wiki_page, upload_project_file) may read from, separated by
# os.pathsep (";" on Windows, ":" on Linux/macOS). Unset or empty means
# uploads are refused entirely — see SECURITY.md before setting this.
# REDMINE_UPLOAD_ROOTS=/home/you/redmine-uploads
